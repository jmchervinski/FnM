{
  "name": "fnm-foundry-vtt",
  "version": "0.1.0",
  "description": "Sistema não-oficial de Feiticeiros & Maldições para Foundry VTT",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packs": "node tools/build-packs.mjs",
    "check": "node tools/check-fichas.mjs && node tools/testa-automacao.mjs",
    "lint": "eslint module/**/*.mjs tools/**/*.mjs",
    "format": "prettier --write \"**/*.{js,mjs,json,html,css}\"",
    "release": "node tools/preparar-release.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0"
  }
}
